N8N_HOST=subdomain.domain.com   # no https://
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL="https://subdomain.domain.com:443"   # your public-facing URL through the reverse proxy
N8N_PATH=/
N8N_PROXY_HOPS=1
N8N_PUSH_BACKEND=websocket

NODE_ENV=production
GENERIC_TIMEZONE=Europe/Berlin   # https://en.wikipedia.org/wiki/List_of_tz_database_time_zones

N8N_DIAGNOSTICS_ENABLED=false
N8N_TEMPLATES_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
